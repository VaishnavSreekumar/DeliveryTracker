# DeliveryTracker Environment Configuration Template
# Copy to .env and configure provider credentials for live production dispatch.

# Database Configuration
CONNECTION_STRING=Data Source=delivery.db

# JWT Authentication
JWT_SECRET_KEY=DeliveryTrackerSuperSecretKey2026!Format32BytesLengthKey
JWT_ISSUER=DeliveryTrackerAPI
JWT_AUDIENCE=DeliveryTrackerClients

# Multi-Channel Notification Mode ('Real' or 'Simulation')
NOTIFICATION_MODE=Real

# Multi-Channel Email Provider Selection ('SMTP' for Local Gmail, 'HTTP' for Production Resend)
EMAIL_PROVIDER=HTTP
EMAIL_ENABLED=true

# Production HTTPS Email Provider (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
HTTP_EMAIL_API_URL=https://api.resend.com/emails
HTTP_EMAIL_FROM=onboarding@resend.dev
HTTP_EMAIL_FROM_NAME=DeliveryTracker Dispatch

# Local Development SMTP Email Configuration (Gmail / Mailtrap)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=deliverytracker.dispatch@gmail.com
SMTP_FROM_NAME=DeliveryTracker Dispatch

# Multi-Channel SMS Configuration (Twilio)
SMS_ENABLED=true
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+18005550199
