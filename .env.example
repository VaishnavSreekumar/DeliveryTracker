# DeliveryTracker Environment Configuration Template

# Database
CONNECTION_STRING=Data Source=delivery.db

# JWT Authentication
JWT_SECRET_KEY=DeliveryTrackerSuperSecretKey2026!Format32BytesLengthKey
JWT_ISSUER=DeliveryTrackerAPI
JWT_AUDIENCE=DeliveryTrackerClients

# Multi-Channel Notifications Configuration
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_PROVIDER=Development # Options: Development, Smtp
NOTIFICATION_EMAIL_FROM=notifications@deliverytracker.com

# SMTP Settings (Required if NOTIFICATION_EMAIL_PROVIDER=Smtp)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# SMS Settings
NOTIFICATION_SMS_ENABLED=true
NOTIFICATION_SMS_PROVIDER=Development # Options: Development, Twilio
NOTIFICATION_SMS_FROM=+18005550199
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
